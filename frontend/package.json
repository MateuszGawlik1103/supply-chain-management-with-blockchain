        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^26.0.0",
        "node": "^20.19.0",
        "prettier": "3.5.2",
        "react-icons": "^5.5.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0",
        "vitest": "3.0.6"
    }
