{
    "name": "test-app-1",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "imports": {
        "#*": "./src/*"
    },
    "dependencies": {
        "axios": "^1.13.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.9.6",
        "uuid": "^11.1.0"
    },
    "scripts": {
        "test": "vitest run --config ./config/vitest.config.ts",
        "coverage": "vitest run --config ./config/vitest.config.ts --coverage && generate-coverage-report -p ./assets/coverage",
        "lint": "eslint --config ./config/eslint.config.mjs",
