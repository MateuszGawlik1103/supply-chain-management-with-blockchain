/**
 * File is used by TypeScript to configure how TypeScript should compile the code.
 * For PRODUCTION use.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023"],
    "skipLibCheck": true,

    /* Bundler mode */
    "rootDir": ".",
    "baseUrl": "./src",
    "paths": { "#*": ["./*"] },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "esModuleInterop": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["config/**/*"],
  "exclude": ["node_modules"]
}
